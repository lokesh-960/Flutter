rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    function isDocumentFile() {
      return (request.resource.contentType.matches('application/pdf')
           || request.resource.contentType.matches('text/.*'))
          && request.resource.size < 25 * 1024 * 1024; // 25MB limit
    }

    // Course learning resources and thumbnails
    match /courses/{courseId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && (isImageFile() || isDocumentFile());
    }

    // User profile avatars
    match /users/{userId}/avatar {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImageFile();
    }
  }
}
